# Public Sanity project identifier.
# Get it from Sanity Manage -> project settings, or `sanity projects list`.
# This is an identifier, never a write token.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset used by the GitHub Pages production build and local development.
# Create or reuse the Sanity dataset named `development`; do not point the
# production build at an unmanaged dataset.
NEXT_PUBLIC_SANITY_DATASET=

# Pinned Sanity API date in YYYY-MM-DD format.
# Choose the reviewed API date used by this repository; do not use a moving value.
NEXT_PUBLIC_SANITY_API_VERSION=

# Optional server-only read token. Leave unset while the development dataset is
# publicly readable. If private reads are enabled later, create the narrowest
# read-only token in Sanity Manage and store it only in local secrets.
SANITY_READ_TOKEN=

# Server-only secret shared by Sanity's signed publish webhook and
# `/api/revalidate`. Generate a new random value for each environment and enter
# it separately in Sanity and your deployment platform; never prefix it with
# NEXT_PUBLIC_.
SANITY_REVALIDATE_SECRET=

# Exact public origin for the current environment, without a trailing slash.
# Local development normally uses the local Next.js origin.
NEXT_PUBLIC_SITE_ORIGIN=
