{
  "name": "wind-flower-poetry-wine-tea-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "node scripts/build-github-pages.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "test:e2e:preview": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test --config=playwright.preview.config.ts",
    "test:e2e:update": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test --update-snapshots",
    "test:watch": "vitest",
    "preview:check": "node scripts/check-preview-env.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@sanity/webhook": "^4.0.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^28.1.0",
    "motion": "^12.42.2",
    "next": "^16.2.12",
    "next-intl": "^4.13.4",
    "next-sanity": "^13.2.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.6.0",
    "styled-components": "^6.4.4",
    "tailwindcss": "^4.3.3",
    "vitest-axe": "^0.1.0",
    "yet-another-react-lightbox": "^3.28.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "packageManager": "npm@10.9.2"
}
